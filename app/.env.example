# ─────────────────────────────────────────────────────────────────────────────
# Skim Protocol v1 — single-process runner env (app/.env.example)
#
# Copy to app/.env and fill in real values:  cp app/.env.example app/.env
# This ONE file covers all three components (bot + listener webhook + keeper).
# NEVER commit a populated .env — app/.env is gitignored.
#
# Vars marked [REQUIRED] must be present or the process refuses to boot, naming
# the missing var. Everything else has a safe default.
# ─────────────────────────────────────────────────────────────────────────────

# ── bot ──────────────────────────────────────────────────────────────────────
# [REQUIRED] Telegram bot token from @BotFather (format: <digits>:<token>).
TELEGRAM_BOT_TOKEN=

# [REQUIRED] Solana RPC endpoint. Public devnet is fine for a free beta; a paid
# RPC is strongly recommended in production.
RPC_URL=https://api.devnet.solana.com

# On-chain program id (only touched by the deferred PDA/session rail in v1).
PROGRAM_ID=2YHE64pk9NB5NZea7MUGKTdP6zKcjSg4dxdQUuxjdhqp

# [REQUIRED] Treasury pubkey (base58) that receives the 0.4% protocol fee.
TREASURY=

# Protocol fee in basis points. 40 = 0.4%. Informational in v1 (the keeper
# hard-codes PROTOCOL_FEE_BPS = 40 in the engine).
PROTOCOL_FEE_BPS=40

# ── keeper ───────────────────────────────────────────────────────────────────
# [REQUIRED] Path to the keeper hot keypair. Accepts a JSON byte array file or a
# base58 secret string. Its pubkey is the delegate users approve in /spawn_wallet
# (also exported to the bot as KEEPER_DELEGATE automatically).
KEEPER_KEYPAIR=./keys/keeper.json

# ── listener webhook (the ONE public port) ───────────────────────────────────
# [REQUIRED] Shared secret the inbound webhook must present as
# `Authorization: Bearer <WEBHOOK_SECRET>`. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=

# The single public HTTP port serving GET /health and POST /webhook/tx.
WEBHOOK_PORT=4000

# ── shared state ─────────────────────────────────────────────────────────────
# Shared user store written by the bot, read by the keeper.
# Default: <repo-root>/data/users.json
USER_STORE_PATH=

# Durable state dir for the keeper queue / dedupe / dead-letter files.
# Default: <repo-root>/data/v1-state
# KEEPER_STATE_DIR=

# ── keeper tuning (optional, safe defaults) ──────────────────────────────────
# SOL balance floor (lamports) below which sweeps are refused (0.005 SOL).
# KEEPER_MIN_LAMPORTS=5000000
# Priority fee, micro-lamports per compute unit.
# PRIORITY_FEE_MICRO_LAMPORTS=1000
# Compute unit limit per sweep transaction.
# COMPUTE_UNIT_LIMIT=200000
# Dedupe TTL in hours — a restart cannot double-sweep within this window.
# DEDUPE_TTL_HOURS=24
# Retry queue: bounded attempts + exponential backoff (ms).
# SWEEP_MAX_ATTEMPTS=4
# SWEEP_BACKOFF_BASE_MS=250
# SWEEP_BACKOFF_MAX_MS=4000
# Token bucket: sweep submissions per second and burst capacity.
# SWEEP_RATE_PER_SEC=5
# SWEEP_BURST=5
# Enforce the per-user approvedMints allowlist (default false = lenient).
# MINT_ALLOWLIST_ENFORCE=false
# Read the mint's owning program to support Token-2022 mints (default true).
# DETECT_TOKEN_PROGRAM=true
# TOKEN_PROGRAM_CACHE_MS=300000

# ── advanced (multi-provider only) ───────────────────────────────────────────
# The v1 single-process runner forwards the engine call IN-PROCESS, so the old
# HTTP-hop vars are NOT needed: KEEPER_URL, KEEPER_SHARED_SECRET,
# KEEPER_PORT, LISTENER_DATA_DIR. They are intentionally absent here.
