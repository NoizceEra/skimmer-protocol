{
  "name": "skim-v1-app",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Skim Protocol v1 single-process runner — bot + listener webhook + keeper engine in ONE process.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\"",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "typescript": "^5.4.5"
  }
}
