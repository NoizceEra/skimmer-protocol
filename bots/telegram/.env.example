# Copy to .env — never commit .env
# ── Required ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=2YHE64pk9NB5NZea7MUGKTdP6zKcjSg4dxdQUuxjdhqp
TREASURY=
# The keeper pubkey whose BOUNDED delegate approval the user grants (base58).
# This is the delegate the /spawn_wallet approval tx is built for.
KEEPER_DELEGATE=

# ── Optional ──────────────────────────────────────────────────────────────────
# Override the shared store location (default: <repo-root>/data/users.json).
USER_STORE_PATH=
PROTOCOL_FEE_BPS=40
# Per-mint UI-token ceiling for the bounded approval (decimals-aware on top of this).
MAX_ALLOWANCE_UI=100
