# Skim keeper environment (documentation / template — NO real secrets here).
#
# Loaded from keeper/.env by dotenv at startup (src/server.ts).
# Required vars are validated at boot; the keeper exits with a clear message
# if any are missing.

# --- REQUIRED ---------------------------------------------------------------

# Solana RPC endpoint. Devnet for testing, a paid provider in production.
# A private RPC is strongly recommended (public endpoints rate-limit).
RPC_URL=https://api.devnet.solana.com

# Filesystem path to the keeper's hot keypair. Either format is accepted:
#   * a JSON array of 64 bytes:  [12,34,...]
#   * a base58 secret key string: 4cPBYKVnu1Vi3VQCA4bow...
KEEPER_KEYPAIR=./keys/keeper.json

# Treasury pubkey (base58). The 0.4% protocol fee is transferred to this
# account's ATA for the output mint.
TREASURY=4QGvLj3RaH6idVKmn5PBYdsCMGhemuhnmtnAAcjinMLd

# Bearer secret for POST /sweep. Compared in constant time. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEEPER_SHARED_SECRET=change-me-to-a-long-random-string

# --- OPTIONAL ---------------------------------------------------------------

# HTTP port for /health and /sweep (default 5001).
KEEPER_PORT=5001

# Override the shared user store path.
# Default: <repo-root>/data/users.json
# USER_STORE_PATH=./data/users.json

# Where persistent state lives: dedupe.json, queue.json, deadletter.json.
# Default: keeper/.state
# KEEPER_STATE_DIR=./.state

# Balance guard: refuse to send sweeps when the keeper's SOL is below this
# floor, and surface `lowFunds: true` on /health. Default 5000000 (0.005 SOL).
# KEEPER_MIN_LAMPORTS=5000000

# Priority fee: micro-lamports per compute unit. Default 1000.
# PRIORITY_FEE_MICRO_LAMPORTS=1000

# Compute unit limit per sweep transaction. Default 200000.
# COMPUTE_UNIT_LIMIT=200000

# Dedupe TTL in hours — a restart cannot double-sweep within this window.
# DEDUPE_TTL_HOURS=24

# Retry queue: bounded attempts + exponential backoff.
# SWEEP_MAX_ATTEMPTS=4
# SWEEP_BACKOFF_BASE_MS=250
# SWEEP_BACKOFF_MAX_MS=4000

# Token bucket: sweep submissions per second, and burst capacity.
# SWEEP_RATE_PER_SEC=5
# SWEEP_BURST=5

# Enforce the per-user `approvedMints` allowlist (default false = lenient).
# MINT_ALLOWLIST_ENFORCE=false

# Read the mint's owning program to support Token-2022 mints (default true).
# DETECT_TOKEN_PROGRAM=true
# TOKEN_PROGRAM_CACHE_MS=300000
