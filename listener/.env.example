# skim-listener configuration. Copy to .env and fill in real values.
# NEVER commit a populated .env.

# --- inbound webhook (frozen interface v1) ------------------------------------
# Port the listener HTTP API binds to. Default 4000.
WEBHOOK_PORT=4000
# Shared secret Helius must send as `Authorization: Bearer <WEBHOOK_SECRET>`.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=change-me

# --- keeper forwarding (frozen interface v1) ----------------------------------
# Base URL of the skim keeper. The listener POSTs ${KEEPER_URL}/sweep.
KEEPER_URL=http://localhost:5001
# Bearer secret the listener sends to the keeper.
KEEPER_SHARED_SECRET=change-me-too
# Max forward attempts before a job is dead-lettered. Optional, default 5.
FORWARD_RETRIES=5

# --- optional extras (safe to omit) -------------------------------------------
# Where the durable queue (queue.jsonl / dead-letter.jsonl) is stored.
# Defaults to listener/data/.
#LISTENER_DATA_DIR=
# Inbound webhook rate limits. Defaults: 60/min per IP, 600/min globally.
#WEBHOOK_RATE_LIMIT_PER_IP=60
#WEBHOOK_RATE_LIMIT_GLOBAL=600
#WEBHOOK_RATE_WINDOW_MS=60000
